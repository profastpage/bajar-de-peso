# ============================================================
# .gitignore - Bajar de Peso (Landing + Guía)
# ============================================================

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NUNCA commitear .env real - puede tener tokens de MercadoPago)
.env
.env.local
.env.*.local
.env.production
.env.development

# ejemplo de env SÍ se commitea
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log
dev.log
dev.out.log
server.log

# bases de datos locales
db/*.db
db/*.db-journal
db/*.db-shm
db/*.db-wal

# tool-results y archivos temporales
tool-results/
.z-ai-config
.claude
local-*
prompt
test

# skills
/skills/

# editores
.vscode/
.idea/
*.swp
*.swo
*~

# sistema operativo
Thumbs.db
ehthumbs.db
Desktop.ini

# descargas pesadas (preview local, no necesario en repo)
download/*.mp4
download/*.zip
