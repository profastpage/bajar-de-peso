# ============================================================
# .env.example - Variables de entorno necesarias
# ============================================================
# Copia este archivo a .env y completa los valores reales.

# URL pública del sitio (sin slash final). Ej: https://bajar-de-peso.tudominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Token de acceso de MercadoPago (cuenta vendedora).
# Obtener en: https://www.mercadopago.com.pe/developers/panel/app
# Modo sandbox (pruebas): empieza con TEST-
# Modo producción: empieza con APP_USR-
# Si lo dejas vacío o contiene "DEMO", la landing funciona en MODO DEMO
# (no cobra de verdad, solo simula el flujo de Checkout Pro).
MERCADO_PAGO_ACCESS_TOKEN=

# Base de datos local (SQLite). No tocar si no cambias la ruta.
DATABASE_URL=file:./db/custom.db
